
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Tabla multiplicar</title>
</head>
<body>
    <h1>Tabla de multiplicar</h1>
    <div>
        @using (Html.BeginForm("Index", "Home", FormMethod.Post))
        {
            <label for="numero">Ingrese el número de la tabla de multiplicar a mostrar:</label>
            <input type="number" id="numero" name="numero" required />
            <input type="submit" value="Generar Tabla" />
        }
    </div>
    <div>
        @if (ViewBag.numero == null)
        {
            <p>Por favor, ingrese un número para ver su tabla de multiplicar.</p>
        } else
        {
        <h2>Tabla de multiplicar del @ViewBag.numero</h2>
        <table border="1">
            <tr>
                <th>Multiplicador</th>
                <th>Resultado</th>
            </tr>
            @for (int i = 1; i <= 25; i++)
            {
                <tr>
                    <td>@ViewBag.numero X @i</td>
                    <td>@(ViewBag.numero * i)</td>
                </tr>
            }
        </table>
        }
    </div>
</body>
</html>
